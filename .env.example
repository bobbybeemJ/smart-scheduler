# --- LLM ---
USE_MOCK_LLM=true
GEMINI_API_KEY=
# gemini-2.0-flash-lite returned 0 free-tier quota as of 2026-07 (deprecated for free tier).
# gemini-flash-lite-latest worked but was unreliable on compound sentences in real usage
# (duration/day-part combinations correct only ~25-33% of the time, occasional chain-of-thought
# leaking into output fields). gemini-3.6-flash was 6/6 correct on the same fragile phrases and
# faster per call - verified via scripts/sanity/list_gemini_models.py and direct testing.
# Trade-off: the full flash tier's free-tier quota is 5 requests/minute vs 15 for the lite tier -
# acceptable for a voice conversation (STT+TTS overhead naturally paces turns well under that),
# but worth re-checking if usage patterns change.
GEMINI_MODEL=gemini-3.6-flash

# --- Google OAuth (Calendar) ---
# Obtained once locally via `python scripts/oauth_bootstrap.py`, then copied here
# and into the Render dashboard env vars. Never commit real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- STT ---
# Live server-side faster-whisper fallback, used only when the browser has no
# Web Speech API support. Escape hatch if Render shows memory pressure.
ENABLE_SERVER_STT_FALLBACK=true
WHISPER_FALLBACK_MODEL=tiny.en
WHISPER_LOCAL_TEST_MODEL=base.en

# --- TTS ---
TTS_VOICE=en-US-AriaNeural

# --- Calendar timezone ---
# The calendar owner's IANA timezone - required because the real Google Calendar API needs
# timezone-aware timestamps regardless of what timezone the server itself runs in.
USER_TIMEZONE=Asia/Kolkata

# --- Server ---
PORT=8000
LOG_LEVEL=INFO
