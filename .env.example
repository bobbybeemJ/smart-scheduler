# --- LLM ---
USE_MOCK_LLM=true

# Which backend app/llm/client.py dispatches to - "anthropic" (default) or "gemini". See
# app/llm/anthropic_backend.py and app/llm/gemini_backend.py docstrings for the full comparison:
# Claude Haiku 4.5 scored 18/18 clean on a battery that included every serious bug found on
# gemini-flash-lite-latest, at roughly $0.003/call. gemini_backend.py is kept as a fallback
# option (its regex fixes stay scoped there, not deleted) in case Anthropic pricing/quota ever
# becomes a blocker.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

GEMINI_API_KEY=
# gemini-2.0-flash-lite returned 0 free-tier quota as of 2026-07 (deprecated for free tier).
# gemini-3.6-flash and gemini-3.5-flash both scored 6/6 on phrases that were fragile on the lite
# model, but BOTH also hit an identical hard 429 wall at 20 requests/DAY on this project's key -
# not the ~1500 RPD/15 RPM commonly quoted for gemini-3.5-flash's free tier. Confirmed this is a
# real daily cap, not a pacing issue: waited the API's own reported retryDelay, then 100+ seconds
# fully untouched, still got 429 both times, on both models, on different days.
# Settled on gemini-flash-lite-latest as the only Gemini model with consistently usable
# free-tier quota. Its compound-sentence unreliability (duration/day-part combos, occasional
# chain-of-thought or outright garbage leaking into output fields) is handled with targeted
# deterministic fixes in app/llm/gemini_backend.py - see its docstring. Only relevant if
# LLM_PROVIDER=gemini; re-verify via scripts/sanity/list_gemini_models.py plus a small paced test
# batch if quota errors reappear, since exact daily caps aren't documented anywhere in advance.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Google OAuth (Calendar) ---
# Obtained once locally via `python scripts/oauth_bootstrap.py`, then copied here
# and into the Render dashboard env vars. Never commit real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- STT ---
# Live server-side faster-whisper fallback, used only when the browser has no
# Web Speech API support. Escape hatch if Render shows memory pressure.
ENABLE_SERVER_STT_FALLBACK=true
WHISPER_FALLBACK_MODEL=tiny.en
WHISPER_LOCAL_TEST_MODEL=base.en

# --- TTS ---
TTS_VOICE=en-US-AriaNeural

# --- Calendar timezone ---
# The calendar owner's IANA timezone - required because the real Google Calendar API needs
# timezone-aware timestamps regardless of what timezone the server itself runs in.
USER_TIMEZONE=Asia/Kolkata

# --- Server ---
PORT=8000
LOG_LEVEL=INFO
